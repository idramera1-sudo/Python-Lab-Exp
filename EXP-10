	1.	Start
	2.	Create dataset
	3.	Remove null values
	4.	Display data
	5.	Stop

#Code

import pandas as pd

data = {"A": [1, 2, None, 4], "B": [5, None, 7, 8]}

df = pd.DataFrame(data)

print("Original Data:")
print(df)

df = df.dropna()

print("Cleaned Data:")
print(df)

print("Info:")
print(df.info())

