import pandas as pd
import matplotlib.pyplot as plt

x = []
y = []

n = int(input("Enter number of points: "))

for i in range(n):
    x.append(int(input()))
    y.append(int(input()))

df = pd.DataFrame({"x": x, "y": y})

plt.plot(df["x"], df["y"])
plt.xlabel("X")
plt.ylabel("Y")
plt.title("Line Graph")
plt.show()

